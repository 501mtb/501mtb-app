rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function userPath(uid) {
      return /databases/(default)/documents/users/$(uid);
    }
    function isAdmin() {
      return signedIn()
        && firestore.exists(userPath(request.auth.uid))
        && firestore.get(userPath(request.auth.uid)).data.role == "ADMIN";
    }
    function isApprovedMember() {
      return signedIn()
        && firestore.exists(userPath(request.auth.uid))
        && firestore.get(userPath(request.auth.uid)).data.approvalStatus == "APPROVED";
    }

    // Shared 501MTB photo library: approved members can upload and browse.
    match /sharedPhotos/{uid}/{fileName} {
      allow read: if isApprovedMember() || isAdmin();
      allow create: if signedIn()
        && request.auth.uid == uid
        && (isApprovedMember() || isAdmin())
        && request.resource.size < 15 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if signedIn()
        && (isAdmin() || (request.auth.uid == uid && isApprovedMember()));
      allow update: if false;
    }

    // Feed photos are stored in the uploader's own folder.
    match /feed/{uid}/{fileName} {
      allow read: if true;
      allow create: if signedIn()
        && request.auth.uid == uid
        && (isApprovedMember() || isAdmin())
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if signedIn()
        && (isAdmin() || (request.auth.uid == uid && isApprovedMember()));
      allow update: if false;
    }
  }
}
