rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function counterPath() {
      return /databases/$(database)/documents/counters/memberSequence;
    }

    function hasUserRecord() {
      return signedIn() && exists(userPath(request.auth.uid));
    }

    function isAdmin() {
      return hasUserRecord()
        && get(userPath(request.auth.uid)).data.role == "ADMIN";
    }

    function isApprovedMember() {
      return hasUserRecord()
        && get(userPath(request.auth.uid)).data.approvalStatus == "APPROVED";
    }

    function isOwnUser(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function assignedIdMatchesCounter() {
      return getAfter(counterPath()).data.lastIssuedBy == request.auth.uid
        && getAfter(counterPath()).data.lastIssuedId == request.resource.data.memberId;
    }

    match /users/{uid} {
      allow read: if isOwnUser(uid) || isAdmin();

      // New accounts receive their R-### ID in the same atomic transaction as the counter.
      allow create: if isOwnUser(uid)
        && request.resource.data.keys().hasOnly([
          "uid", "email", "displayName", "photoURL", "role",
          "approvalStatus", "memberId", "createdAt"
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.role == "USER"
        && request.resource.data.approvalStatus == "PENDING"
        && request.resource.data.memberId is string
        && request.resource.data.memberId.matches("R-[0-9]{3}")
        && assignedIdMatchesCounter();

      // Existing profiles without an ID may receive one; other account changes remain admin-only.
      allow update: if isAdmin()
        || (isOwnUser(uid)
          && !resource.data.keys().hasAny(["memberId"])
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["memberId"])
          && request.resource.data.memberId is string
          && request.resource.data.memberId.matches("R-[0-9]{3}")
          && assignedIdMatchesCounter());

      allow delete: if isAdmin();
    }

    match /counters/{counterId} {
      allow read: if signedIn() && counterId == "memberSequence";
      allow create: if signedIn()
        && counterId == "memberSequence"
        && request.resource.data.keys().hasOnly(["lastIssued", "lastIssuedId", "lastIssuedBy"])
        && request.resource.data.lastIssued == 1
        && request.resource.data.lastIssuedId == "R-001"
        && request.resource.data.lastIssuedBy == request.auth.uid
        && getAfter(userPath(request.auth.uid)).data.memberId == "R-001";
      allow update: if signedIn()
        && counterId == "memberSequence"
        && request.resource.data.keys().hasOnly(["lastIssued", "lastIssuedId", "lastIssuedBy"])
        && request.resource.data.lastIssued == resource.data.lastIssued + 1
        && request.resource.data.lastIssued <= 999
        && request.resource.data.lastIssuedId is string
        && request.resource.data.lastIssuedId.matches("R-[0-9]{3}")
        && request.resource.data.lastIssuedBy == request.auth.uid
        && getAfter(userPath(request.auth.uid)).data.memberId == request.resource.data.lastIssuedId;
      allow delete: if false;
    }

    match /members/{memberId} {
      allow read: if resource.data.publicProfile == true || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /memberLinks/{memberId} {
      allow read, write: if isAdmin();
    }

    match /rides/{rideId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();

      match /registrations/{uid} {
        allow read: if isAdmin() || isOwnUser(uid);
        allow create: if isOwnUser(uid)
          && isApprovedMember()
          && request.resource.data.keys().hasOnly(["uid", "status", "registeredAt"])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.status == "REGISTERED"
          && request.resource.data.registeredAt == request.time;
        allow update: if isAdmin();
        allow delete: if isAdmin() || (isOwnUser(uid) && isApprovedMember());
      }

      match /attendance/{memberId} {
        allow read: if isAdmin()
          || (isApprovedMember()
            && get(userPath(request.auth.uid)).data.memberId == memberId);
        allow create, update, delete: if isAdmin();
      }
    }

    match /feedPosts/{postId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          "authorUid", "authorName", "caption", "imageUrl", "storagePath",
          "visibility", "createdAt"
        ])
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.imageUrl is string
        && request.resource.data.storagePath is string
        && request.resource.data.caption is string
        && request.resource.data.visibility in ["COMMUNITY", "OFFICIAL"]
        && request.resource.data.createdAt == request.time
        && ((isApprovedMember() && request.resource.data.visibility == "COMMUNITY") || isAdmin());
      allow update: if false;
      allow delete: if signedIn()
        && (resource.data.authorUid == request.auth.uid || isAdmin());
    }

    match /events/{eventId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /announcements/{announcementId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /publicStats/{documentId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /adminLogs/{logId} {
      allow read, write: if isAdmin();
    }
  }
}
